# Copy to .env at the repository root (gitignored; Docker Compose reads it from
# there) and fill in values. Never commit real secrets.
#   cp backend/.env.example .env

# ---- Local Docker Compose (local-only values) ----
POSTGRES_DB=drivon
POSTGRES_USER=drivon
# Local throwaway DB. If you change it, also export DB_PASSWORD when running the API from an IDE.
POSTGRES_PASSWORD=drivon
# 5433 so a locally installed PostgreSQL on the default 5432 does not clash.
POSTGRES_PORT=5433
API_PORT=8080

# ---- Backend (production, set in Render's environment) ----
SPRING_PROFILES_ACTIVE=prod
# Neon connection string in JDBC form; sslmode=require is mandatory.
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=<neon-user>
DB_PASSWORD=<neon-password>
# Render injects PORT automatically.
# Base64 HS256 signing key, at least 256 bits: openssl rand -base64 48
# (The dev profile has a built-in, publicly known key; prod requires this.)
JWT_SECRET=<base64-secret-from-openssl>
