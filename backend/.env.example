# Copy to .env at the repository root (gitignored; Docker Compose reads it from
# there) and fill in values. Never commit real secrets.
#   cp backend/.env.example .env

# ---- Local Docker Compose (local-only values) ----
POSTGRES_DB=drivon
POSTGRES_USER=drivon
# Local throwaway DB. If you change it, also export DB_PASSWORD when running the API from an IDE.
POSTGRES_PASSWORD=drivon
# 5433 so a locally installed PostgreSQL on the default 5432 does not clash.
POSTGRES_PORT=5433
API_PORT=8080

# ---- Backend (production, set in Render's environment) ----
SPRING_PROFILES_ACTIVE=prod
# Neon connection string in JDBC form; sslmode=require is mandatory.
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=<neon-user>
DB_PASSWORD=<neon-password>
# Render injects PORT automatically.
# Base64 HS256 signing key, at least 256 bits: openssl rand -base64 48
# (The dev profile has a built-in, publicly known key; prod requires this.)
JWT_SECRET=<base64-secret-from-openssl>

# ---- Cloudflare R2 (documents) ----
# Optional in development (document uploads are disabled without them), required
# in production. Create an R2 API token with "Object Read & Write" on this bucket
# only; the account ID is the first part of the S3 endpoint URL.
# When running the API from IntelliJ, set these in the run configuration's
# environment variables instead (keep "Store as project file" unchecked).
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=drivon-documents-dev

# ---- Reminders and push notifications ----
# Firebase console -> Project settings -> Service accounts -> Generate new private
# key, then Base64-encode the downloaded JSON file (PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("<path>.json"))
# Optional in development (reminders then show in the app only), required in production.
FIREBASE_SERVICE_ACCOUNT_BASE64=<base64-of-service-account-json>
# Shared secret of POST /internal/reminders/run, also stored as a GitHub secret for
# .github/workflows/reminders-cron.yml. At least 32 characters: openssl rand -base64 32
# (The dev profile has a built-in, publicly known secret; prod requires this.)
REMINDERS_JOB_SECRET=<random-secret-at-least-32-chars>
