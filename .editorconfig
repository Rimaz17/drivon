root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format uses 2 spaces; Spotless enforces it.
indent_size = 2
max_line_length = 100

[*.{xml,yml,yaml,json,dart,sql}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
