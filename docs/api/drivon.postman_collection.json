    {
      "name": "Expenses",
      "item": [
        {
          "name": "Log expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/expenses",
