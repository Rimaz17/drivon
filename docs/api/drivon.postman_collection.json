    {
      "name": "Documents",
      "description": "Needs the R2_* variables on the server (otherwise 503 STORAGE_UNAVAILABLE). The file goes straight to storage with the presigned URL, without the API token.",
      "item": [
        {
          "name": "Start upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/documents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"INSURANCE\",\n  \"issueDate\": \"{{today}}\",\n  \"notes\": \"Comprehensive policy\",\n  \"contentType\": \"application/pdf\",\n  \"sizeBytes\": 22\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('documentId', body.document.id);",
                  "pm.collectionVariables.set('uploadUrl', body.upload.url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload file to storage",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/pdf" }],
            "url": "{{uploadUrl}}",
            "body": {
              "mode": "raw",
              "raw": "%PDF-1.4 Drivon sample"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('stored', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm upload",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/documents/{{documentId}}/confirm" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('active', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List documents",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/documents?sort=expiryDate,asc" },
          "event": [
