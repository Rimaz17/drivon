{
  "info": {
    "name": "Drivon API",
    "description": "Requests for the Drivon REST API. Set baseUrl (local: http://localhost:8080). Run 'Register' (or 'Login'), then the folders in order: tokens and IDs are stored in collection variables by the test scripts, and {{today}} is set to today's date in Sri Lanka. Cleanup deletes the vehicle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "correct-horse-battery" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "fuelRecordId", "value": "" },
    { "key": "readingId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "expenseId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "uploadUrl", "value": "" },
    { "key": "today", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('email')) {",
          "  pm.collectionVariables.set('email', `driver-${Date.now()}@example.com`);",
          "}",
          "// Record dates are Sri Lankan calendar dates (YYYY-MM-DD).",
          "pm.collectionVariables.set('today', new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Colombo' }));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Platform",
      "item": [
        {
          "name": "Health",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/actuator/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports UP', () => pm.expect(pm.response.json().status).to.eql('UP'));",
                  "pm.test('has request id', () => pm.response.to.have.header('X-Request-Id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI document",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/v3/api-docs" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Driver\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('code is INVALID_CREDENTIALS', () => pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/users/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no password hash', () => pm.expect(pm.response.json()).to.not.have.property('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me without token",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/v1/users/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('code is UNAUTHENTICATED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Create vehicle",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Aqua\",\n  \"year\": 2018,\n  \"registrationNumber\": \"CAB-{{$randomInt}}\",\n  \"fuelType\": \"HYBRID\",\n  \"currentOdometerKm\": 45000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 (or 422 once two vehicles exist)', () => pm.expect(pm.response.code).to.be.oneOf([201, 422]));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('vehicleId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List vehicles",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get vehicle",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Update vehicle",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Aqua G\",\n  \"year\": 2018,\n  \"registrationNumber\": \"CAB-0001\",\n  \"fuelType\": \"HYBRID\",\n  \"currentOdometerKm\": 46000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fuel",
      "item": [
        {
          "name": "Log full fill-up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"litres\": \"30.000\",\n  \"amount\": \"10950.00\",\n  \"odometerKm\": 46000,\n  \"fullTank\": true,\n  \"station\": \"Ceypetco Kollupitiya\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('price per litre is derived', () => pm.expect(pm.response.json().pricePerLitre).to.eql('365.00'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log partial fill-up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"litres\": \"10.000\",\n  \"amount\": \"3650.00\",\n  \"odometerKm\": 46200,\n  \"fullTank\": false,\n  \"station\": \"Ceypetco Kollupitiya\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('partial fills have no km/L', () => pm.expect(pm.response.json().kmPerLitre).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log next full fill-up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"litres\": \"15.000\",\n  \"amount\": \"5475.00\",\n  \"odometerKm\": 46500,\n  \"fullTank\": true,\n  \"station\": \"Ceypetco Kollupitiya\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('500 km over 25 L is 20 km/L', () => pm.expect(pm.response.json().kmPerLitre).to.eql('20.00'));",
                  "pm.collectionVariables.set('fuelRecordId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log fill-up with a mismatched price",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"litres\": \"30\",\n  \"amount\": \"12000\",\n  \"pricePerLitre\": \"365\",\n  \"odometerKm\": 46600,\n  \"fullTank\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('code is FUEL_PRICE_MISMATCH', () => pm.expect(pm.response.json().code).to.eql('FUEL_PRICE_MISMATCH'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List fill-ups",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records?page=0&size=20&sort=date,desc" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('is a page', () => pm.expect(pm.response.json()).to.have.property('totalElements'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get fill-up",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records/{{fuelRecordId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fuel stats",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-stats" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('average km/L', () => pm.expect(pm.response.json().averageKmPerLitre).to.eql('20.00'));",
                  "pm.test('cost per km', () => pm.expect(pm.response.json().costPerKm).to.eql('18.25'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Monthly fuel spend",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-stats/monthly?months=6" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('six months', () => pm.expect(pm.response.json()).to.have.length(6));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update fill-up",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records/{{fuelRecordId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"litres\": \"15.500\",\n  \"amount\": \"5657.50\",\n  \"odometerKm\": 46500,\n  \"fullTank\": true,\n  \"station\": \"Ceypetco Kollupitiya\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete fill-up",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}/fuel-records/{{fuelRecordId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
