# Normalise line endings: LF in the repo for everything except Windows scripts.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
